# ==============================================================================
# agent-decision-router: Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Workers AI (Free Tier: 10,000 Neurons/day, No Credit Card Req.)
# ------------------------------------------------------------------------------
# How to get your CLOUDFLARE_ACCOUNT_ID:
#   1. Sign in to https://dash.cloudflare.com/
#   2. Click "Workers & Pages" in the left-hand navigation sidebar.
#   3. Look at the right sidebar under "Account details" -> "Account ID", OR
#      look at your browser address bar: https://dash.cloudflare.com/<ACCOUNT_ID>/...
#   Example: cff5621f049317330e5cce45c7bdc92d
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# How to get your CLOUDFLARE_API_TOKEN:
#   1. Open the API Tokens page: https://dash.cloudflare.com/profile/api-tokens
#   2. Click "Create Token" -> Scroll to "Custom Token" -> Click "Get started".
#   3. Set Token Name: "agent-decision-router"
#   4. Under "Permissions", set:
#        Account | Workers AI | Read
#   5. Under "Account Resources", set:
#        Include | All accounts (or choose your specific account)
#   6. Click "Continue to summary" -> Click "Create Token".
#   7. Copy the generated token string immediately (Cloudflare only displays it once).
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare System 1 Decision Model:
# Default: @cf/cloudflare/clef-flash (9B multimodal fast decision model)
# Alternative: @cf/cloudflare/clef (27B multimodal decision model)
CLOUDFLARE_MODEL=@cf/cloudflare/clef-flash


# ------------------------------------------------------------------------------
# 2. Local Ollama / System One Provider (Optional Fallback)
# ------------------------------------------------------------------------------
# Used when ROUTER_BACKEND=ollama or as an interchangeable local endpoint.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nimble


# ------------------------------------------------------------------------------
# 3. Router Backend Selection
# ------------------------------------------------------------------------------
# Options:
#   - 'cloudflare' : Uses Cloudflare Workers AI REST API (default, recommended)
#   - 'ollama'     : Uses local Ollama /v1/systemone endpoint
#   - 'mock'       : Uses local deterministic/heuristic engine (no API keys required)
ROUTER_BACKEND=cloudflare


# ------------------------------------------------------------------------------
# 4. Decision Pipeline & Confidence Gate Thresholds
# ------------------------------------------------------------------------------
# CONFIDENCE_THRESHOLD_HIGH:
#   If model confidence >= this value, action executes immediately as EXECUTABLE.
#   Default: 0.70 (70%)
CONFIDENCE_THRESHOLD_HIGH=0.70

# CONFIDENCE_THRESHOLD_LOW:
#   If model confidence is between LOW and HIGH (0.40 <= conf < 0.70), shallow
#   bounded lookahead (MCTS heuristic) is triggered to resolve ambiguity.
#   If confidence < LOW (< 0.40), execution is refused as DECLINED to prevent
#   hallucinated tool calls.
#   Default: 0.40 (40%)
CONFIDENCE_THRESHOLD_LOW=0.40


# ------------------------------------------------------------------------------
# 5. Stage 1 Fast-Path Cache (Zero-Latency Exact Hash Matching)
# ------------------------------------------------------------------------------
# Enable or disable the Stage 1 content-addressable SHA-256 state cache
FAST_PATH_CACHE_ENABLED=true

# Time-To-Live in seconds before cached decision entries expire (default: 1 hour)
FAST_PATH_CACHE_TTL_SECONDS=3600

# Maximum number of entries in the LRU cache before eviction
FAST_PATH_CACHE_MAX_SIZE=1024


# ------------------------------------------------------------------------------
# 6. Standalone FastAPI REST Microservice Configuration
# ------------------------------------------------------------------------------
ROUTER_HOST=0.0.0.0
ROUTER_PORT=8000
